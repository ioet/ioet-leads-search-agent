# Local mock stack — point workers/agent at these URLs (see mocks/run_mocks.sh)

SERVICE_URL_SEARCH_COMPANIES=http://127.0.0.1:8001
SERVICE_URL_FIND_DECISION_MAKERS=http://127.0.0.1:8001
SERVICE_URL_SCORE_COMPANIES_ICP=http://127.0.0.1:8002
SERVICE_URL_MATCH_IOET_SKILLS=http://127.0.0.1:8002
SERVICE_URL_DRAFT_OUTREACH_EMAIL=http://127.0.0.1:8002
SERVICE_URL_SANITIZE_PUBLIC_FIELDS=http://127.0.0.1:8004
SERVICE_URL_UPSERT_HUBSPOT=http://127.0.0.1:8004
SERVICE_URL_NOTIFY=http://127.0.0.1:8005
SERVICE_URL_NOTIFY_FAILURE=http://127.0.0.1:8005

SKILLS_SERVICE_URL=http://127.0.0.1:8003

# Real integration — Bedrock API key (same vars as birthday_slack_bot)
# Optional per-request override: pass model_id on agent POST bodies.
AWS_BEDROCK_API_KEY=
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID_HIGH=google.gemma-3-27b-it
AWS_BEDROCK_MODEL_ID_LOW=google.gemma-3-4b-it

# Real Apollo/HubSpot/Bamboo/Slack — when set, hybrid runners start the real service
APOLLO_API_KEY=
HUBSPOT_SERVICE_KEY=
BAMBOOHR_API_KEY=
SLACK_WEBHOOK_URL=

# Campaign size (workers prefer these over lhctl max-leads when set)
MAX_COMPANIES=3
MAX_CONTACTS_PER_COMPANY=2
