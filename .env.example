# LittleHorse (local kernel uses defaults: localhost:2023)
LHC_API_HOST=localhost
LHC_API_PORT=2023

# Microservice base URLs (used by workflow/workers.py HTTP tasks)
SERVICE_URL_SEARCH_COMPANIES=http://localhost:8001
SERVICE_URL_SCORE_COMPANIES_ICP=http://localhost:8002
SERVICE_URL_FIND_DECISION_MAKERS=http://localhost:8001
SERVICE_URL_SANITIZE_PUBLIC_FIELDS=http://localhost:8004
SERVICE_URL_EXTRACT_JOB_SKILLS=http://localhost:8006
SERVICE_URL_MATCH_IOET_SKILLS=http://localhost:8002
SERVICE_URL_DRAFT_OUTREACH_EMAIL=http://localhost:8002
SERVICE_URL_UPSERT_HUBSPOT=http://localhost:8004
SERVICE_URL_NOTIFY=http://localhost:8005
SERVICE_URL_NOTIFY_FAILURE=http://localhost:8005
# Local-only tasks (no SERVICE_URL): select-top-leads, build-campaign-summary,
# build-empty-search-notification, count-companies, fetch-ioet-skills-catalog

# External integrations
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
HUBSPOT_SERVICE_KEY=
HUBSPOT_BASE_URL=https://api.hubapi.com
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=
BAMBOOHR_SKILLS_FIELD=skills
BAMBOOHR_CACHE_TTL_SECONDS=300
BAMBOOHR_FETCH_DETAILS=true
SLACK_WEBHOOK_URL=

# AWS Bedrock (agent-service — Bearer API key, same as birthday_slack_bot)
# Optional per-request override: pass model_id on agent POST bodies.
# High complexity: ICP scoring, outreach email (Gemma 3 27B). Low: skill extraction, catalog matching (Gemma 3 4B).
AWS_BEDROCK_API_KEY=
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID_HIGH=google.gemma-3-27b-it
AWS_BEDROCK_MODEL_ID_LOW=google.gemma-3-4b-it
SKILLS_SERVICE_URL=http://localhost:8003

# Per-campaign skills catalog snapshot — durable store only (no in-memory/refetch fallback)
# fetch-ioet-skills-catalog writes; match-ioet-skills reads by catalog_ref
# Local: filesystem under .cache/skills-catalogs/
# Deployed: set SKILLS_CATALOG_S3_BUCKET
SKILLS_CATALOG_LOCAL_DIR=.cache/skills-catalogs
# SKILLS_CATALOG_STORAGE=filesystem
# SKILLS_CATALOG_S3_BUCKET=
# SKILLS_CATALOG_S3_PREFIX=skills-catalogs
# SKILLS_CATALOG_S3_REGION=us-east-1

# Job posting discovery (jobs-service)
JOB_POSTING_SOURCES=linkedin,company_website
JOB_POSTINGS_MAX_PER_SOURCE=5
LINKEDIN_JOBS_ACCESS_TOKEN=

TASK_TIMEOUT_SECONDS=120
TASK_RETRIES=3

# Campaign size (workers prefer these over lhctl max-leads when set)
MAX_COMPANIES=3
MAX_CONTACTS_PER_COMPANY=2

# HubSpot mock — local filesystem output (when using mocks/hubspot)
HUBSPOT_MOCK_OUTPUT_DIR=.cache/hubspot-mock

# Notify mock — local Slack message output (when using mocks/notify)
NOTIFY_MOCK_OUTPUT_DIR=.cache/notify-mock
